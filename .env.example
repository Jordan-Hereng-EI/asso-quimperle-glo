# Variables d'environnement de production.
# En pratique vous n'avez PAS à créer ce fichier sur le VPS : le déploiement
# GitHub Actions l'écrit automatiquement depuis les secrets du dépôt.
# Ce fichier documente ce que chaque secret GitHub doit contenir.

# --- Base de données (conteneur db) ---
# POSTGRES_USER et POSTGRES_DB ont des valeurs par défaut (quimperle / quimperle_glo) ;
# seul le mot de passe est obligatoire.
POSTGRES_PASSWORD=

# --- Admin ---
# E-mail du compte administrateur.
ADMIN_EMAIL=
# Hash du mot de passe, au format "sel:hash".
# À générer avec :  cd admin && npm run hash-password -- "VotreMotDePasse"
ADMIN_PASSWORD_HASH=
# Secret de signature des sessions (64 caractères hexadécimaux conseillés).
# À générer avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
